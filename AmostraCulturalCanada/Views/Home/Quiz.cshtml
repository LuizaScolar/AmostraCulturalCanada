@{
    ViewData["Title"] = "Quiz Cultural";
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/quiz.css" asp-append-version="true" />

<div class="container">
    <div class="quiz-container">
        <div class="quiz-header" id="quizHeader">
            <h2 class="text-vinho" style="font-weight: 800;">DESAFIO DAS <span class="led-red-vivo">RAÍZES</span></h2>
            <p class="text-muted">Bem-vindo(a), <strong>@ViewBag.NomeUsuario</strong>! Teste o que aprendeu.</p>
        </div>

        <div id="quizArea">
            <h3 class="question-title" id="questionText">Carregando...</h3>
            <div id="optionsArea"></div>
            <div class="text-end">
                <button class="btn-next" id="btnNext" onclick="nextQuestion()">Próxima ></button>
            </div>
        </div>

        <div class="result-box" id="resultArea">
            <h2 class="text-vinho" style="font-weight: bold;">SEU RESULTADO</h2>
            <div class="score-text" id="scoreDisplay">0/5</div>
            <p class="text-muted mt-3" id="feedbackText" style="font-weight:500;"></p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark mt-4">Voltar à Home</a>
            <a href="@Url.Action("Logout", "Home")" class="btn btn-danger mt-4 ms-2">Logout</a>
        </div>
    </div>
</div>

<script src="~/js/quiz.js"></script>